force-app/main/default/objects/Location/fields/PickupProcessingTime.field-meta.xml
force-app/main/default/objects/Location/fields/PickupProcessingTimeUnit.field-meta.xml

# Standard Account fields requiring Partner/Channel features
force-app/main/default/objects/Account/fields/ChannelProgramLevelName.field-meta.xml
force-app/main/default/objects/Account/fields/ChannelProgramName.field-meta.xml
force-app/main/default/objects/Account/fields/IsCustomerPortal.field-meta.xml
force-app/main/default/objects/Account/fields/IsPartner.field-meta.xml