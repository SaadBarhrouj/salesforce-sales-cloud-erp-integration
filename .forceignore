package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

# Commerce objects not available in Developer scratch orgs
**/objects/ProductCatalog/**
**/objects/ProductCategory/**
**/objects/ProductCategoryProduct/**
**/layouts/ProductCatalog-*
**/layouts/ProductCategory-*
**/flexipages/Catalog_Record_Page.flexipage-meta.xml
**/flexipages/Category_Record_Page.flexipage-meta.xml

# Custom Metadata Type objects (definitions)
**/objects/*__mdt/


# Ignore problematic standard fields on Location object (require OrderManagement feature not enabled in scratch org)
force-app/main/default/objects/Location/fields/DefaultPickupTime.field-meta.xml
force-app/main/default/objects/Location/fields/DefaultProcessingTime.field-meta.xml
force-app/main/default/objects/Location/fields/DefaultProcessingTimeUnit.field-meta.xml
force-app/main/default/objects/Location/fields/EarliestPickupTimeOffset.field-meta.xml
force-app/main/default/objects/Location/fields/FulfillingBusinessHoursId.field-meta.xml
force-app/main/default/objects/Location/fields/IsEligibleForPickup.field-meta.xml
force-app/main/default/objects/Location/fields/LatestPickupTimeOffset.field-meta.xml
force-app/main/default/objects/Location/fields/PickupProcessingTime.field-meta.xml
force-app/main/default/objects/Location/fields/PickupProcessingTimeUnit.field-meta.xml

# Ignore standard Account fields requiring specific features 
force-app/main/default/objects/Account/fields/ChannelProgramLevelName.field-meta.xml
force-app/main/default/objects/Account/fields/ChannelProgramName.field-meta.xml
