        String suffix = nextSuffix();
        User recordItem = new User(
            Alias = 'tuser',
            Email = 'testuser+' + suffix + '@example.com',
            EmailEncodingKey = 'UTF-8',
            LastName = 'User',
            LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_US',
            ProfileId = UserInfo.getProfileId(),
            TimeZoneSidKey = 'America/New_York',
