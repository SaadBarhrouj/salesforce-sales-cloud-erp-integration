    public static Bundle_Feature__c createBundleFeature(Boolean doInsert) {
        Product2 product = createProduct2(true);
        return createBundleFeature(product.Id, 'Test Feature ' + nextSuffix(), sequence, 'Generated by TestDataFactory', 0, 5, doInsert);
    }

    /**
     * @description Creates a test Bundle_Feature__c record with custom values.
     * @param bundleProductId The Product2 ID (bundle product).
     * @param name Feature name.
     * @param sortOrder Sort order for display.
     * @param helpText Help text for the feature.
     * @param minOptions Minimum options to select.
     * @param maxOptions Maximum options to select.
     * @param doInsert Whether to insert the record into the database.
     * @return The created Bundle_Feature__c record.
     */
    public static Bundle_Feature__c createBundleFeature(
        Id bundleProductId,
        String name,
        Integer sortOrder,
        String helpText,
        Decimal minOptions,
        Decimal maxOptions,
        Boolean doInsert
    ) {
        Bundle_Feature__c recordItem = new Bundle_Feature__c(
            Name = name,
            Sort_Order__c = sortOrder,
            Product__c = bundleProductId,
            Help_Text__c = helpText,
            Min_Options__c = minOptions,
            Max_Options__c = maxOptions
        );
        if (doInsert) {
            insert recordItem;
        }
        return recordItem;
    }

    /**
     * @description Creates a test Bundle_Option__c record.
     * @param doInsert Whether to insert the record into the database.
     * @return The created Bundle_Option__c record.
     */
    public static Bundle_Option__c createBundleOption(Boolean doInsert) {
        Product2 bundleProduct = createProduct2(true);
        Product2 optionProduct = createProduct2(true);
        Bundle_Feature__c feature = createBundleFeature(true);
        return createBundleOption(bundleProduct.Id, optionProduct.Id, feature.Id, 'Component', sequence, 1, 0, 10, false, false, false, doInsert);
    }

    /**
     * @description Creates a test Bundle_Option__c record with custom values.
     * @param bundleProductId The bundle Product2 ID.
     * @param optionProductId The option Product2 ID.
     * @param featureId The Bundle_Feature__c ID (can be null for unassigned options).
     * @param optionType Type of option (e.g., 'Component', 'Service').
     * @param sortOrder Sort order for display.
     * @param defaultQuantity Default quantity.
     * @param minQuantity Minimum quantity.
     * @param maxQuantity Maximum quantity.
     * @param quantityEditable Whether quantity is editable.
     * @param isRequired Whether option is required.
     * @param isSelected Whether option is selected by default.
     * @param doInsert Whether to insert the record into the database.
     * @return The created Bundle_Option__c record.
     */
    public static Bundle_Option__c createBundleOption(
        Id bundleProductId,
        Id optionProductId,
        Id featureId,
        String optionType,
        Integer sortOrder,
        Decimal defaultQuantity,
        Decimal minQuantity,
        Decimal maxQuantity,
        Boolean quantityEditable,
        Boolean isRequired,
        Boolean isSelected,
        Boolean doInsert
    ) {
        Bundle_Option__c recordItem = new Bundle_Option__c(
            Option_Type__c = optionType,
            Sort_Order__c = sortOrder,
            Bundle_Product__c = bundleProductId,
            Option_Product__c = optionProductId,
            Feature__c = featureId,
            Default_Quantity__c = defaultQuantity,
            Min_Quantity__c = minQuantity,
            Max_Quantity__c = maxQuantity,
            Quantity_Editable__c = quantityEditable,
            Is_Required__c = isRequired,
            Is_Selected__c = isSelected
        );
        if (doInsert) {
            insert recordItem;
        }
        return recordItem;
    }
 

