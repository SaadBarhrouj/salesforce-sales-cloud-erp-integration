/**
 * Test data factory utility for creating test records in unit tests.
 * Provides static factory methods to generate Salesforce records with consistent test data.
 */
@IsTest
public class TestDataFactory {
    private static Integer sequence = 0;

    private static String nextSuffix() {
        sequence++;
        return String.valueOf(DateTime.now().getTime()) + String.valueOf(sequence);
    }


    /**
     * Creates a test User record.
     * 
     * @param doInsert If true, inserts the record into the database
     * @return User record with test data
     */
    public static User createUser(Boolean doInsert) {
        String suffix = nextSuffix();
        User recordItem = new User(
            Alias = 'tuser',
            Email = 'testuser+' + suffix + '@example.com',
            EmailEncodingKey = 'UTF-8',
            LastName = 'User',
            LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_US',
            ProfileId = UserInfo.getProfileId(),
            TimeZoneSidKey = 'America/New_York',
            Username = 'testuser+' + suffix + '@example.com'
        );
        if (doInsert) {
            insert recordItem;
        }
        return recordItem;
    }

    /**
     * Creates a test Account record.
