@IsTest
public class TestDataFactory {
    private static Integer sequence = 0;

    public static User createUser(Boolean doInsert) {
        String suffix = nextSuffix();
        User recordItem = new User(
            Alias = 'tuser',
            Email = 'testuser+' + suffix + '@example.com',
            EmailEncodingKey = 'UTF-8',
            LastName = 'User',
            LanguageLocaleKey = 'en_US',
            LocaleSidKey = 'en_US',
            ProfileId = UserInfo.getProfileId(),
            TimeZoneSidKey = 'America/New_York',
            Username = 'testuser+' + suffix + '@example.com'
        );
        if (doInsert) {
            insert recordItem;
        }
        return recordItem;
    }


    public static Account createAccount(Boolean doInsert) {

        Account recordItem = new Account(
            Name = 'Test Account ' + nextSuffix(),
            Active__c = 'Yes',
            Description = 'Generated by TestDataFactory'
        );
        if (doInsert) {
            insert recordItem;
        }
        return recordItem;
    }

    public static Product2 createProduct2(Boolean doInsert) {

        Product2 recordItem = new Product2(
            Name = 'Test Product ' + nextSuffix(),
            IsActive = true,
            Description = 'Generated by TestDataFactory',
            Unit_Weight_Kg__c = 1
        );
        if (doInsert) {
            insert recordItem;
        }
        return recordItem;
    }

    public static Bundle_Feature__c createBundleFeature(Boolean doInsert) {
        Product2 product = createProduct2(true);
        Bundle_Feature__c recordItem = new Bundle_Feature__c(
            Name = 'Test Feature ' + nextSuffix(),
            Sort_Order__c = sequence,
            Product__c = product.Id,
            Help_Text__c = 'Generated by TestDataFactory',
            Min_Options__c = 0,
            Max_Options__c = 5
        );
        if (doInsert) {
            insert recordItem;
        }
        return recordItem;
    }

    public static Bundle_Option__c createBundleOption(Boolean doInsert) {
        Product2 bundleProduct = createProduct2(true);
        Product2 optionProduct = createProduct2(true);
        Bundle_Feature__c feature = createBundleFeature(true);
        
        Bundle_Option__c recordItem = new Bundle_Option__c(
            Option_Type__c = 'Product',
            Sort_Order__c = sequence,
            Bundle_Product__c = bundleProduct.Id,
            Option_Product__c = optionProduct.Id,
            Feature__c = feature.Id,
            Default_Quantity__c = 1,
            Min_Quantity__c = 0,
            Max_Quantity__c = 10,
            Is_Selected__c = false,
            Is_Required__c = false,
            Quantity_Editable__c = false
        );
        if (doInsert) {
            insert recordItem;
        }
        return recordItem;
    }

    private static String nextSuffix() {
        sequence++;
        return String.valueOf(DateTime.now().getTime()) + String.valueOf(sequence);
    }
}
