<apex:page standardController="Quote" extensions="QuotePDFController" 
    renderAs="pdf" applyBodyTag="false" applyHtmlTag="false" showHeader="false" sidebar="false">

    <head>
        <style type="text/css">
            @page {
                size: A4;
                margin-top: 50px;
                margin-bottom: 80px;

                @bottom-center {
                    content: element(runningFooter);
                }
            }

            body {
                font-family: Arial, Helvetica, sans-serif;
                font-size: 9.5pt; /* Slightly reduced for a pro feel */
                color: #333;
                line-height: 1.3;
            }

            .running-footer {
                position: running(runningFooter);
                width: 100%;
                text-align: center;
                font-size: 8.5pt;
                color: #666;
            }

            .quote-title {
                font-size: 16pt;
                font-weight: bold;
                color: #333;
            }

            .quote-expires {
                font-size: 9pt;
                color: #999;
            }

            .logo-cell {
                text-align: right;
                width: 150px;
                font-size: 14pt;
                font-weight: bold;
                color: #005FB2;
            }

            /* Pro Table styling */
            .grid-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 15px;
            }

            .grid-table th, .grid-table td {
                border: 1px solid #ccc;
                padding: 4px 6px;
            }

            .label-header {
                background-color: #DDEBF7;
                font-weight: bold;
                font-size: 10pt;
                text-align: left;
            }

            .data-table-th {
                background-color: #DDEBF7;
                font-weight: bold;
                text-align: left;
                font-size: 9pt;
            }

            .data-table-td {
                font-size: 9.5pt;
            }

            .bundle-row .data-table-td {
                background-color: #f5f5f5;
                font-weight: bold;
            }

            .subtotal-row .data-table-td {
                background-color: #DDEBF7;
                font-weight: bold;
            }

            .number-cell {
                text-align: right;
            }

            .totals-label {
                text-align: right;
                font-weight: bold;
                background-color: #DDEBF7;
            }

            .grand-total .totals-label,
            .grand-total .totals-value {
                font-size: 11pt;
                font-weight: bold;
                border-top: 2px solid #666 !important;
                border-bottom: 2px solid #666 !important;
            }

            .empty-state {
                text-align: center;
                color: #999;
                font-style: italic;
                padding: 15px;
                border: 1px solid #ccc;
                margin-bottom: 15px;
            }

            .section-title {
                font-size: 11pt;
                font-weight: bold;
                margin: 15px 0 5px 0;
            }

            .volume-pricing-header {
                background-color: #f5f5f5; /* Lighter gray to contrast with tables */
                font-weight: bold;
                padding: 4px 6px;
                border: 1px solid #ccc;
                border-bottom: none;
                font-size: 9.5pt;
            }

            .terms-section {
                margin-top: 25px;
                font-size: 8.5pt;
                text-align: justify;
            }

            .terms-section ol {
                padding-left: 20px;
                margin-top: 5px;
            }

            .terms-section ol li {
                margin-bottom: 4px;
            }

            .signature-table {
                width: 100%;
                margin-top: 25px;
                border-collapse: collapse;
            }

            .signature-table td {
                padding: 0 15px 30px 15px;
                vertical-align: bottom;
            }

            .signature-field {
                display: inline-block;
                border-bottom: 1px solid #333;
                width: 200px;
                margin-left: 5px;
            }

            .signature-label {
                font-size: 8.5pt;
                color: #666;
                font-style: italic;
            }

            .thank-you-banner {
                background-color: #DDEBF7;
                text-align: center;
                padding: 8px;
                margin-top: 25px;
                font-size: 10pt;
                font-weight: bold;
            }

            .page-number:before {
                content: "Page " counter(page) " of " counter(pages);
            }

            .subhead {
                font-size: 8.5pt;
                color: #666;
            }
        </style>
    </head>

    <body>
        <!-- Repeating Footer -->
        <div class="running-footer">
            <span class="page-number"></span>
        </div>

        <!-- Master Table to force repeating headers safely -->
        <table width="100%" style="width: 100%; border-collapse: collapse; border: none;">
            
            <!-- THIS IS THE HEADER THAT REPEATS ON EVERY PAGE -->
            <thead style="display: table-header-group;">
                <tr>
                    <td style="padding-bottom: 20px; border: none;">
                        <table width="100%" border="0" cellpadding="0" cellspacing="0" style="width: 100%;">
                            <tr>
                                <td valign="middle" style="text-align: left; width: 50%;">
                                    <div style="font-size: 16pt; font-weight: bold; color: #333;">Quote {!Quote.QuoteNumber}</div>
                                    <div style="font-size: 9pt; color: #999;">Expires {!ExpirationDateFormatted}</div>
                                </td>
                                <td valign="middle" style="text-align: right; width: 50%;">
                                    <apex:image url="{!$Resource.LoxamLogo}" height="80" alt="Loxam Logo" />
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </thead>

            <!-- THIS IS YOUR ACTUAL PAGE CONTENT -->
            <tbody>
                <tr>
                    <td style="border: none;">

        <!-- Prepared For / Prepared By -->
        <table class="grid-table">
            <tr>
                <td width="50%" class="label-header">Prepared For</td>
                <td width="50%" class="label-header">Prepared By</td>
            </tr>
            <tr>
                <td width="50%" valign="top">
                    <apex:outputText value="{!AccountName}" /><br />
                    <apex:outputText value="{!ContactName}" /><br />
                    <apex:outputField value="{!Quote.Contact.Email}" /><br />
                    <apex:outputField value="{!Quote.Contact.Phone}" />
                </td>
                <td width="50%" valign="top">
                    <apex:outputText value="{!$Organization.Name}" /><br />
                    <apex:outputText value="{!Quote.Owner.Name}" /><br />
                    <apex:outputText value="{!Quote.Owner.Email}" /><br />
                    <apex:outputText value="{!$Organization.Phone}" />
                </td>
            </tr>
        </table>

        <!-- Line Items Section -->
        <div class="section-title">Line Items</div>

        <apex:outputPanel rendered="{!hasLineItems}">
            <table class="grid-table">
                <tr>
                    <th class="data-table-th">QTY</th>
                    <th class="data-table-th">PRODUCT</th>
                    <th class="data-table-th">UNIT PRICE</th>
                    <th class="data-table-th">DISCOUNT</th>
                    <th class="data-table-th">RENTAL START</th>
                    <th class="data-table-th">RENTAL END</th>
                    <th class="data-table-th number-cell">TOTAL</th>
                </tr>
                <apex:repeat value="{!pdfData.lineItems}" var="row">
                    <tr class="{!IF(row.isBundle, 'bundle-row', '')}">
                        <td class="data-table-td number-cell">
                            <apex:outputText value="{0, number, #,##0}">
                                <apex:param value="{!row.quantity}" />
                            </apex:outputText>
                        </td>
                        <td class="data-table-td">
                            <apex:outputText value="{!row.productName}" />
                            <apex:outputPanel rendered="{!row.isBundle}">
                            </apex:outputPanel>
                        </td>
                        <td class="data-table-td number-cell">
                            <apex:outputText value="{0, number, $#,###,##0.00}">
                                <apex:param value="{!row.unitPrice}" />
                            </apex:outputText>
                        </td>
                        <td class="data-table-td number-cell">
                            <apex:outputText value="{0, number, #,##0.00}%">
                                <apex:param value="{!row.discount}" />
                            </apex:outputText>
                        </td>
                        <td class="data-table-td number-cell">
                            <apex:outputText value="{0, date, MM/dd/yyyy}">
                                <apex:param value="{!row.rentalStartDate}" />
                            </apex:outputText>
                        </td>
                        <td class="data-table-td number-cell">
                            <apex:outputText value="{0, date, MM/dd/yyyy}">
                                <apex:param value="{!row.rentalEndDate}" />
                            </apex:outputText>
                        </td>
                        <td class="data-table-td number-cell">
                            <apex:outputText value="{0, number, $#,###,##0.00}">
                                <apex:param value="{!row.totalPrice}" />
                            </apex:outputText>
                        </td>
                    </tr>
                </apex:repeat>

                <tr class="subtotal-row">
                    <td class="data-table-td" colspan="6">Products Subtotal</td>
                    <td class="data-table-td number-cell">{!LineItemsSubtotal}</td>
                </tr>
            </table>
        </apex:outputPanel>

        <apex:outputPanel rendered="{!NOT(hasLineItems)}">
            <div class="empty-state">No line items on this quote.</div>
        </apex:outputPanel>

        <!-- Volume Pricing Section -->
        <apex:outputPanel rendered="{!hasVolumePricing}">
            <div class="section-title">Volume Pricing Schedules</div>

            <table class="grid-table">
                <tr>
                    <th class="data-table-th">Quantity Range</th>
                    <th class="data-table-th number-cell">Price</th>
                </tr>
                <apex:repeat value="{!pdfData.lineItems}" var="row">
                    <apex:outputPanel rendered="{!row.volumePricingTiers != null}" layout="none">
                        <apex:repeat value="{!row.volumePricingTiers}" var="vpRow">
                            <tr class="bundle-row">
                                <td colspan="2" class="data-table-td">
                                    {!vpRow.productName} — Pricing Type: {!vpRow.pricingType}
                                    <apex:outputPanel rendered="{!AND(NOT(ISBLANK(vpRow.overageRate)), vpRow.overageRate > 0)}">
                                        (Overage Rate: <apex:outputText value="{0, number, $#,###,##0.00}"><apex:param value="{!vpRow.overageRate}"/></apex:outputText>)
                                    </apex:outputPanel>
                                </td>
                            </tr>
                            <apex:repeat value="{!vpRow.tiers}" var="tier">
                                <tr>
                                    <td class="data-table-td">
                                        <apex:outputText value="{0, number, #,##0}"><apex:param value="{!tier.lowerBound}"/></apex:outputText>
                                        <apex:outputPanel rendered="{!AND(NOT(ISBLANK(tier.upperBound)), tier.upperBound > 0)}">
                                            - <apex:outputText value="{0, number, #,##0}"><apex:param value="{!tier.upperBound}"/></apex:outputText>
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!OR(ISBLANK(tier.upperBound), tier.upperBound == 0)}">
                                            +
                                        </apex:outputPanel>
                                    </td>
                                    <td class="data-table-td number-cell"><apex:outputText value="{0, number, $#,###,##0.00}"><apex:param value="{!tier.price}"/></apex:outputText></td>
                                </tr>
                            </apex:repeat>
                        </apex:repeat>
                    </apex:outputPanel>
                </apex:repeat>
            </table>
        </apex:outputPanel>

        <!-- Transport Costs Section -->
        <apex:outputPanel rendered="{!ShowTransportSection}">
            <div class="section-title">Transport Costs</div>

            <table class="grid-table">
                <tr>
                    <th class="data-table-th">Direction</th>
                    <th class="data-table-th number-cell">Distance (km)</th>
                    <th class="data-table-th number-cell">Weight (kg)</th>
                    <th class="data-table-th">Truck Type</th>
                    <th class="data-table-th number-cell">Price</th>
                </tr>
                <apex:repeat value="{!pdfData.trips}" var="trip">
                    <tr>
                        <td class="data-table-td">{!trip.direction}</td>
                        <td class="data-table-td number-cell">
                            <apex:outputText value="{0, number, #,##0.0}">
                                <apex:param value="{!trip.distanceKm}" />
                            </apex:outputText>
                        </td>
                        <td class="data-table-td number-cell">
                            <apex:outputText value="{0, number, #,##0}">
                                <apex:param value="{!trip.totalWeightKg}" />
                            </apex:outputText>
                        </td>
                        <td class="data-table-td">{!trip.truckType}</td>
                        <td class="data-table-td number-cell"><apex:outputText value="{0, number, $#,###,##0.00}"><apex:param value="{!trip.finalPrice}"/></apex:outputText></td>
                    </tr>
                </apex:repeat>

                <tr class="subtotal-row">
                    <td class="data-table-td" colspan="4">Transport Subtotal</td>
                    <td class="data-table-td number-cell">{!TransportTotal}</td>
                </tr>
            </table>
        </apex:outputPanel>

        <!-- Grand Total -->
        <table class="grid-table" style="width: 40%; float: right; margin-top: 10px;">
            <tr>
                <td class="totals-label">Products Subtotal</td>
                <td class="data-table-td number-cell">{!LineItemsSubtotal}</td>
            </tr>
            <apex:outputPanel rendered="{!ShowTransportSection}" layout="none">
                <tr>
                    <td class="totals-label">Transport</td>
                    <td class="data-table-td number-cell">{!TransportTotal}</td>
                </tr>
            </apex:outputPanel>
            <tr class="grand-total">
                <td class="totals-label">Grand Total</td>
                <td class="data-table-td number-cell">{!GrandTotal}</td>
            </tr>
        </table>

        <div style="clear: both;"></div>

        <!-- Terms & Conditions -->
        <div class="terms-section">
            <strong>Terms &amp; Conditions</strong>
            <ol>
                <li>This quote is valid until the expiration date shown above. Prices and availability are subject to change after this date.</li>
                <li>Payment terms are net 30 days from the date of invoice unless otherwise agreed in writing.</li>
                <li>All rental periods begin on the Rental Start Date and end on the Rental End Date specified in the line items above.</li>
                <li>Transport costs are estimated based on current rates and may be adjusted upon final route confirmation.</li>
            </ol>
        </div>

        <!-- Signature Area -->
        <table class="signature-table">
            <tr>
                <td width="50%">
                    <span class="signature-label">Name:</span>
                    <span class="signature-field"></span>
                </td>
                <td width="50%">
                    <span class="signature-label">Title:</span>
                    <span class="signature-field"></span>
                </td>
            </tr>
            <tr>
                <td width="50%">
                    <span class="signature-label">Effective Date:</span>
                    <span class="signature-field"></span>
                </td>
                <td width="50%">
                    <span class="signature-label">Signature:</span>
                    <span class="signature-field"></span>
                </td>
            </tr>            
        </table>

        <!-- Thank You Banner -->
        <div class="thank-you-banner">
            THANK YOU FOR YOUR BUSINESS!
        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </body>
</apex:page>