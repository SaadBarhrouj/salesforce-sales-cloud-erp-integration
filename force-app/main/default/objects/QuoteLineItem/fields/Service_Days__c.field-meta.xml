<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Service_Days__c</fullName>
    <description>Inclusive number of calendar days between Service_Start_Date__c and Service_End_Date__c (end - start + 1). Zero when either date is blank.</description>
    <externalId>false</externalId>
    <formula>IF(
    AND(NOT(ISBLANK(Service_Start_Date__c)), NOT(ISBLANK(Service_End_Date__c))),
    Service_End_Date__c - Service_Start_Date__c + 1,
    0
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Service Days</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
