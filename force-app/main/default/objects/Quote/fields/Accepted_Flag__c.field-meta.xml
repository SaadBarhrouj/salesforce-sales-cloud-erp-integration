<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Accepted_Flag__c</fullName>
    <description>Helper for Quote Acceptance Rate reporting: 1 when Status is Accepted, else 0.</description>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL(Status, &quot;Accepted&quot;), 1, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Accepted Flag</label>
    <precision>1</precision>
    <required>false</required>
    <scale>0</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
