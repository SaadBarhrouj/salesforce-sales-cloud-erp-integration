<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Duration_ms__c</fullName>
    <description>Calculates the total execution time in milliseconds.</description>
    <externalId>false</externalId>
    <formula>(Response_Timestamp__c - Request_Timestamp__c) * 86400000</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Calculates the total execution time in milliseconds.</inlineHelpText>
    <label>Duration (ms)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
