        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_to_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Discount &lt; 20%</defaultConnectorLabel>
        <rules>
            <name>Needs_Manager_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Discount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
