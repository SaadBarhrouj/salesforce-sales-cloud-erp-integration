<?xml version="1.0" encoding="UTF-8"?>
<Prompt xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>LOXFORCE Docked Prompt - Logistics Manager</masterLabel>
    <promptVersions>
        <actionButtonLabel>Configurer le transport</actionButtonLabel>
        <actionButtonLink>/lightning/setup/CustomMetadata/home</actionButtonLink>
        <body>&lt;p&gt;Découvrez votre espace de paramétrage logistique : zones de transport, véhicules et grilles tarifaires qui alimentent automatiquement le calcul de coût des commerciaux. Réduisez ce panneau quand vous voulez.&lt;/p&gt;</body>
        <delayDays>1</delayDays>
        <description>Docked prompt welcoming Logistics Manager users on the LOXFORCE Home, with an intro video. Targeted to the Logistics Manager permission.</description>
        <displayType>DockedComposer</displayType>
        <experience>Lightning</experience>
        <header>Bienvenue dans LOXFORCE</header>
        <image>loxforce_logistics_overview</image>
        <imageAltText>space logistique LOXFORCE pour la gestion des transports, véhicules et tarifs liés au calcul des coûts.</imageAltText>
        <imageLocation>Top</imageLocation>
        <isPublished>true</isPublished>
        <masterLabel>LOXFORCE Docked Prompt - Logistics Manager</masterLabel>
        <publishedDate>2026-06-05</publishedDate>
        <shouldDisplayActionButton>true</shouldDisplayActionButton>
        <shouldIgnoreGlobalDelay>true</shouldIgnoreGlobalDelay>
        <startDate>2026-06-03</startDate>
        <themeColor>Theme1</themeColor>
        <themeSaturation>Light</themeSaturation>
        <timesToDisplay>10</timesToDisplay>
        <title>Votre espace logistique</title>
        <uiFormulaRule>
            <criteria>
                <leftValue>{!$Permission.CustomPermission.LOXFORCE_Logistics_Manager}</leftValue>
                <operator>EQUAL</operator>
                <rightValue>TRUE</rightValue>
            </criteria>
        </uiFormulaRule>
        <userAccess>SpecificPermissions</userAccess>
        <userProfileAccess>Everyone</userProfileAccess>
        <versionNumber>1</versionNumber>
    </promptVersions>
</Prompt>
